<apex:page sidebar="false" showHeader="false">
    <style>
        .viewer {
            width: 100%;
            height: 600px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #000;
        }
        .viewer img {
            max-width: 90%;
            max-height: 90%;
            animation: rotate 10s linear infinite;
        }
        @keyframes rotate {
            from { transform: rotateY(0deg); }
            to { transform: rotateY(360deg); }
        }
    </style>

    <div class="viewer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/3/3a/3D_Cube_Transparent.png" alt="3D Model Demo"/>
    </div>
</apex:page>
